# ClearGuard Backend — Production Environment Template (FastAPI Cloud / Docker)
# Set these environment variables in your FastAPI Cloud dashboard or .env.production.
# NOTE: Never commit real secrets or .env.production to version control.
# NOTE: Database connection string (DATABASE_URL) is omitted here as managed separately.

# ==============================================================================
# Application Identity & Server
# ==============================================================================
APP_NAME=ClearGuard API
APP_VERSION=0.7.0
APP_ENV=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ==============================================================================
# PostgreSQL Connection Pool Settings (DATABASE_URL managed by cloud provider)
# ==============================================================================
AUTO_MIGRATE_ON_STARTUP=true
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# Security, CORS & Rate Limiting
# ==============================================================================
# JSON array string. Restrict to your admin web domain(s) in production if applicable.
CORS_ORIGINS=["*"]
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
DOWNLOAD_RATE_LIMIT_PER_MINUTE=30

# ==============================================================================
# Authentication & JWT Settings (Milestone B6)
# ==============================================================================
# Generate a strong 48+ byte secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# Admin Emergency Override Keys (Milestone B6 — Ed25519 PEM)
# ==============================================================================
# Leave blank to auto-generate an ephemeral key per worker, or paste multi-line PEM keys.
# Generate with: cryptography.hazmat.primitives.asymmetric.ed25519.Ed25519PrivateKey.generate()
ADMIN_OVERRIDE_PRIVATE_KEY=
ADMIN_OVERRIDE_PUBLIC_KEY=

# ==============================================================================
# Transactional Email / SMTP Settings (Milestone B6 — Partner Notifications)
# ==============================================================================
# Public HTTPS URL of your deployed API (used inside partner verification links)
PUBLIC_BASE_URL=https://your-app.fastapicloud.dev
# Example for personal Gmail with App Password (use the same Gmail address for FROM):
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_YOUR_EMAIL@gmail.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM_EMAIL=CHANGE_ME_YOUR_EMAIL@gmail.com

