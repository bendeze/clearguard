# ClearGuard Backend — Environment Configuration Template
# Copy this file to .env.local for local development.
# NOTE: Never commit .env.local or .env.production to version control.

# Application Environment
# Options: development, staging, production
APP_ENV=development
DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# Database Configuration
# Local development uses SQLite: sqlite:///./clearguard.db
# Production uses PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./clearguard.db

