# ClearGuard Backend — Environment Configuration Template
# Copy this file to .env.local for local development.
# NOTE: Never commit .env.local or .env.production to version control.

# Application Identity & Environment
APP_NAME=ClearGuard API
APP_VERSION=0.5.0
APP_ENV=development
DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Database Configuration
# Local SQLite: sqlite:///./clearguard.db
# Production PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./clearguard.db
DB_ECHO=false

# PostgreSQL Connection Pool Settings (Production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security, CORS & Rate Limiting
CORS_ORIGINS=["*"]
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
DOWNLOAD_RATE_LIMIT_PER_MINUTE=30
