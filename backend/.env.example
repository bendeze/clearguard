# ClearGuard Backend — Environment Configuration Template
# Copy this file to .env.local for local development.
# NOTE: Never commit .env.local or .env.production to version control.

# Application Identity & Environment
APP_NAME=ClearGuard API
APP_VERSION=0.7.0
APP_ENV=development
DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Database Configuration
# Local SQLite: sqlite:///./clearguard.db
# Production PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///./clearguard.db
AUTO_MIGRATE_ON_STARTUP=true
DB_ECHO=false

# PostgreSQL Connection Pool Settings (Production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security, CORS & Rate Limiting
CORS_ORIGINS=["*"]
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
DOWNLOAD_RATE_LIMIT_PER_MINUTE=30

# Authentication & JWT Settings (Milestone B6)
JWT_SECRET_KEY=clearguard-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin Emergency Override Keys (Milestone B6 — Ed25519 PEM)
ADMIN_OVERRIDE_PRIVATE_KEY=
ADMIN_OVERRIDE_PUBLIC_KEY=

# Notification & Transactional Email Settings (Milestone B6)
PUBLIC_BASE_URL=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@clearguard.app
